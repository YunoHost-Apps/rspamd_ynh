#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

if ynh_app_upgrading_from_version_before 4.2.0~ynh1
then
    ynh_safe_rm "/etc/dovecot/global_script/rspamd.sieve"
    ynh_safe_rm "/etc/dovecot/yunohost.d/post-ext.d/antispam.conf"
    per_user=0
    ynh_app_setting_set --key=per_user --value=$per_user
    min_learns=200
    ynh_app_setting_set --key=min_learns --value=$min_learns
fi

if ynh_app_upgrading_from_version_before 4.2.1~ynh1
then
    ynh_safe_rm "/etc/dovecot/global_script/rspamd-report-spam.sieve"
    ynh_safe_rm "/etc/dovecot/global_script/rspamd-report-spam.svbin"
    ynh_safe_rm "/etc/dovecot/global_script/rspamd-report-ham.sieve"
    ynh_safe_rm "/etc/dovecot/global_script/rspamd-report-ham.svbin"
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up $app..."

tmp_dir=$(mktemp -d)

if [[ $YNH_DEBIAN_VERSION == "bookworm" ]]; then
    ynh_setup_source --dest_dir="$tmp_dir" --source_id="deb_bookworm"
elif [[ $YNH_DEBIAN_VERSION == "trixie" ]]; then
    ynh_setup_source --dest_dir="$tmp_dir" --source_id="deb_trixie"
fi

# Install the package
_ynh_apt_install --allow-downgrades "$tmp_dir/rspamd.deb"

# Add the package to dependencies
YNH_APT_INSTALL_DEPENDENCIES_REPLACE="false" ynh_apt_install_dependencies "rspamd"

# Mark the packahe as auto
apt-mark auto "rspamd"

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration files..."

# Add postfix configuration hook and regen postfix conf
ynh_config_add --template="yunohost_postfix_regenconf_hook" --destination="/usr/share/yunohost/hooks/conf_regen/99-postfix_rspamd"
yunohost tools regen-conf postfix

# Add rspamd conf
## Add redis conf
ynh_config_add --template="rspamd_redis.conf" --destination="/etc/rspamd/local.d/redis.conf"

## Add per_user conf
per_user=$(ynh_app_setting_get --key=per_user)
case "$per_user" in
    0) per_user_value="false" ;;
    1) per_user_value="true" ;;
esac
ynh_config_add --template="rspamd_classifier-bayes.conf" --destination="/etc/rspamd/local.d/classifier-bayes.conf"

## Add dkim_signing conf
ynh_config_add --template="rspamd_dkim_signing.conf" --destination="/etc/rspamd/local.d/dkim_signing.conf"

## Add a local recursive resolver for rspamd, DNS lists block YunoHost's shared public upstreams
ynh_config_add --template="unbound_default" --destination="/etc/default/unbound"
ynh_config_add --template="unbound_rspamd.conf" --destination="/etc/unbound/unbound.conf.d/rspamd.conf"
chmod 644 /etc/default/unbound /etc/unbound/unbound.conf.d/rspamd.conf
unbound-checkconf
### The package starts unbound on port 53 right after installation, where dnsmasq already listens
systemctl reset-failed unbound 2>/dev/null || true
ynh_systemctl --service=unbound --action=restart
ynh_config_add --template="rspamd_options.inc" --destination="/etc/rspamd/local.d/options.inc"

## Set permissions
chmod 644 /etc/rspamd/local.d/*

# Add dovecot conf
## Create sieve directories
mkdir -p /etc/dovecot/global_script
mkdir -p /etc/dovecot/imapsieve
mkdir -p /usr/lib/dovecot/sieve-pipe

## Add the config file for spam handling
if [[ $YNH_DEBIAN_VERSION == "bookworm" ]]; then
    ynh_config_add --template="dovecot_rspamd-learning_bookworm.conf" --destination="/etc/dovecot/yunohost.d/post-ext.d/rspamd-learning.conf"
elif [[ $YNH_DEBIAN_VERSION == "trixie" ]]; then
    ynh_config_add --template="dovecot_rspamd-learning_trixie.conf" --destination="/etc/dovecot/yunohost.d/post-ext.d/rspamd-learning.conf"
fi
ynh_systemctl --service=dovecot --action=restart

## Add the sieve script to move Spam mails to the user's Junk folder
ynh_config_add --template="dovecot_rspamd-spam-to-junk-folder.sieve" --destination="/etc/dovecot/global_script/rspamd-spam-to-junk-folder.sieve"
sievec /etc/dovecot/global_script/rspamd-spam-to-junk-folder.sieve

## Deploy imap_sieve scripts for spam/ham learning
### Spam learning
ynh_config_add --template="dovecot_rspamd-report-spam.sieve" --destination="/etc/dovecot/imapsieve/rspamd-report-spam.sieve"
ynh_config_add --template="dovecot_rspamd-learn-spam.sh" --destination="/usr/lib/dovecot/sieve-pipe/rspamd-learn-spam.sh"
sievec /etc/dovecot/imapsieve/rspamd-report-spam.sieve

### Ham learning
ynh_config_add --template="dovecot_rspamd-report-ham.sieve" --destination="/etc/dovecot/imapsieve/rspamd-report-ham.sieve"
ynh_config_add --template="dovecot_rspamd-learn-ham.sh" --destination="/usr/lib/dovecot/sieve-pipe/rspamd-learn-ham.sh"
sievec /etc/dovecot/imapsieve/rspamd-report-ham.sieve

## Set permissions
chown -R vmail:mail /etc/dovecot/global_script/ /etc/dovecot/imapsieve/
chmod 750 /etc/dovecot/global_script/ /etc/dovecot/imapsieve/
chmod 640 /etc/dovecot/global_script/* /etc/dovecot/imapsieve/*
chmod 755 /usr/lib/dovecot/sieve-pipe/
chmod 755 /usr/lib/dovecot/sieve-pipe/*

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

yunohost service add "$app" --description="Spam filtering system"
yunohost service add unbound --description="Recursive DNS resolver for Rspamd"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting systemd services..."

ynh_systemctl --service=postfix --action=restart

ynh_systemctl --service=rspamd --action=restart

ynh_systemctl --service=dovecot --action=restart

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
