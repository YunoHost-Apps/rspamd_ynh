#!/bin/bash

source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

if ynh_app_upgrading_from_version_before 4.2.0~ynh1
then
    ynh_safe_rm "/etc/dovecot/global_script/rspamd.{sieve,svbin}"
    ynh_safe_rm "/etc/dovecot/yunohost.d/post-ext.d/antispam.conf"
fi

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx

# Add redis
ynh_config_add --template="redis.conf" --destination="/etc/rspamd/local.d/redis.conf"
ynh_systemctl --service=rspamd --action="restart"

# Add postfix configuration hook and regen postfix conf
ynh_config_add --template="postfix_regenconf_hook" --destination="/usr/share/yunohost/hooks/conf_regen/99-postfix_rspamd"
yunohost tools regen-conf postfix
ynh_systemctl --service=postfix --action="restart"

# Add dovecot conf
## Add the config file for spam handling
if [[ $YNH_DEBIAN_VERSION == "bookworm" ]]; then
    ynh_config_add --template="dovecot_imap_sieve_bookworm.conf" --destination="/etc/dovecot/yunohost.d/post-ext.d/antispam.conf"
elif [[ $YNH_DEBIAN_VERSION == "trixie" ]]; then
    ynh_config_add --template="dovecot_imap_sieve_trixie.conf" --destination="/etc/dovecot/yunohost.d/post-ext.d/antispam.conf"
fi

## Restart dovecot to load the new conf
ynh_systemctl --service=dovecot --action="restart"

## Add the sieve script to move Spam mails to the user's Junk folder
ynh_config_add --template="rspamd.sieve" --destination="/etc/dovecot/sieve/rspamd.sieve"

## Deploy imap_sieve scripts for spam/ham learning
### Spam learning
ynh_config_add --template="report-spam.sieve" --destination="/etc/dovecot/sieve/report-spam.sieve"
ynh_config_add --template="rspamd-learn-spam.sh" --destination="/etc/dovecot/sieve/rspamd-learn-spam.sh"

### Ham learning
ynh_config_add --template="report-ham.sieve" --destination="/etc/dovecot/sieve/report-ham.sieve"
ynh_config_add --template="rspamd-learn-ham.sh" --destination="/etc/dovecot/sieve/rspamd-learn-ham.sh"

## Compile sieve scripts
sievec "/etc/dovecot/sieve/rspamd.sieve"
sievec "/etc/dovecot/sieve/report-spam.sieve"
sievec "/etc/dovecot/sieve/report-ham.sieve"

## Set permissions
chown -R vmail:mail "/etc/dovecot/sieve"
chmod -R u=rw,go= "/etc/dovecot/sieve"
chmod u+x "/etc/dovecot/sieve/rspamd-learn-{spam,ham}.sh"

## Restart dovecot to load the new sieve scripts
ynh_systemctl --service=dovecot --action="restart"

# Integrate rspamd in YunoHost service list
yunohost service add "$app" --description="Spam filtering system"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
