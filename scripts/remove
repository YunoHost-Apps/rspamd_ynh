#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

#=================================================
# REMOVE SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Removing system configurations related to $app..."

if ynh_hide_warnings yunohost service status $app >/dev/null; then
    yunohost service remove $app
fi

ynh_config_remove_nginx

# Remove rspamd conf
ynh_safe_rm "/etc/rspamd/local.d/redis.conf"
ynh_safe_rm "/etc/rspamd/local.d/classifier-bayes.conf"
if [ -e "/etc/rspamd/local.d/worker-controller.inc" ]
then
    ynh_safe_rm "/etc/rspamd/local.d/worker-controller.inc"
fi

# Remove postfix conf tweak
ynh_safe_rm "/usr/share/yunohost/hooks/conf_regen/99-postfix_rspamd"
yunohost tools regen-conf postfix

# Remove dovecot conf
ynh_safe_rm "/etc/dovecot/yunohost.d/post-ext.d/antispam.conf"
ynh_safe_rm "/etc/dovecot/sieve"
ynh_safe_rm "/usr/lib/dovecot/sieve-pipe"

#=================================================
# START SYSTEMD SERVICE
#=================================================

ynh_systemctl --service=postfix --action=restart

ynh_systemctl --service=dovecot --action=restart

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Removal of $app completed"

#FIXME
apt-cache policy rspamd
systemctl status rspamd.service
ss -tlnp | grep 11332
apt depends rspamd-ynh-deps
apt-cache rdepends --installed rspamd

