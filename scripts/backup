#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

#=================================================
# BACKUP SYSTEM CONFIGURATION
#=================================================

domain=$(ynh_app_setting_get --key=domain)
if [[ "$domain" != "" ]]
then
    ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"
fi

#=================================================
# BACKUP VARIOUS FILES
#=================================================

ynh_backup "/usr/share/yunohost/hooks/conf_regen/99-postfix_rspamd"

ynh_backup "/etc/rspamd/local.d/redis.conf"
ynh_backup "/etc/rspamd/local.d/classifier-bayes.conf"
ynh_backup "/etc/rspamd/local.d/worker-controller.inc"

ynh_backup "/etc/dovecot/yunohost.d/post-ext.d/antispam.conf"
ynh_backup "/etc/dovecot/sieve"
ynh_backup "/usr/lib/dovecot/sieve-pipe"

#=================================================
# END OF SCRIPT
#=================================================

ynh_print_info "Backup script completed for $app. (YunoHost will then actually copy those files to the archive)."
